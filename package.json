{
  "name": "remo-china-leadbot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:locales && next build",
    "start": "next start",
    "lint": "eslint",
    "test:web": "npm run check:locales && node --test tests/web/*.test.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "check:locales:browser": "node scripts/check-locales-browser.mjs",
    "postinstall": "node scripts/ensure-firestore-types.mjs",
    "deploy:hosting": "node scripts/deploy-hosting.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:firebase": "firebase deploy --only hosting,firestore:rules"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^13.4.3",
    "google-auth-library": "11.1.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.29.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "posthog-js": "^1.228.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
